<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.3" prefHeight="800.0" prefWidth="1280.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.monolatte.kontur.controllers.ManufacturerAddressController">
    <items>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <TitledPane animated="false" collapsible="false" text="Выбор производителя" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <TextField fx:id="searchManufacturerField" promptText="Поиск..." />
                                <ListView fx:id="manufacturersListView" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
            </children>
        </VBox>

        <ScrollPane fitToHeight="true" fitToWidth="true">
            <content>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>

                        <TitledPane animated="true" text="Список всех адресов">
                            <content>
                                <TableView fx:id="addressesSummaryTable" minHeight="300.0">
                                    <columns>
                                        <TableColumn fx:id="manufacturerNameColumn" prefWidth="200.0" text="Производитель" />
                                        <TableColumn fx:id="addressDetailsColumn" prefWidth="400.0" text="Детали адреса" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </content>
                        </TitledPane>

                        <TitledPane animated="true" text="Редактирование данных">
                            <content>
                                <VBox spacing="15.0">
                                    <children>
                                        <GridPane hgap="10.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                                <ColumnConstraints hgrow="ALWAYS" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="ID Компонента:" />
                                                <TextField fx:id="componentIdTextField" editable="false" GridPane.columnIndex="1" />

                                                <Label text="Тип адреса:" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="addressTypeComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label text="Город:" GridPane.rowIndex="2" />
                                                <TextField fx:id="cityTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                            </children>
                                        </GridPane>

                                        <Separator />

                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <children>
                                                <Button fx:id="deleteAddressButton" onAction="#onDeleteAddressClicked" text="Удалить" />
                                                <Button fx:id="saveAddressButton" onAction="#onSaveAddressClicked" text="Сохранить изменения" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </TitledPane>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </items>
</SplitPane>