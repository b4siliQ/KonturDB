<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.35" prefHeight="800.0" prefWidth="1280.0"
           stylesheets="@../style/seregaStyle.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.monolatte.kontur.controllers.ContactsPanelController">
    <items>
        <VBox spacing="10.0" styleClass="side-panel">
            <children>
                <Label styleClass="section-header" text="ВЫБОР ПОЛЬЗОВАТЕЛЯ" />
                <TextField fx:id="searchUserField" promptText="Поиск пользователя..." />
                <ListView fx:id="usersListView" VBox.vgrow="ALWAYS" />
            </children>
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
        </VBox>

        <VBox spacing="15.0" styleClass="content-panel">
            <children>
                <VBox spacing="15.0" styleClass="details-card" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-header" text="КОНТАКТНАЯ ИНФОРМАЦИЯ" />

                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>
                                <Label text="ID Пользователя:" />
                                <TextField fx:id="userIdTextField" editable="false" styleClass="read-only-field" GridPane.columnIndex="1" />

                                <Label text="Тип контакта:" GridPane.rowIndex="1" />
                                <ComboBox fx:id="contactTypeComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Значение (адрес/номер):" GridPane.rowIndex="2" />
                                <TextField fx:id="contactValueTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>

                        <Separator />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="deleteContactButton" onAction="#onDeleteContactClicked" styleClass="button-danger" text="Удалить контакт" />
                                <Button fx:id="saveContactButton" onAction="#onSaveContactClicked" styleClass="button-primary" text="Сохранить изменения" />
                            </children>
                        </HBox>

                        <Label styleClass="section-header" text="ВСЕ КОНТАКТЫ (ОБЗОР)">
                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </Label>

                        <TableView fx:id="contactsSummaryTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="userNameColumn" prefWidth="150.0" text="Пользователь" />
                                <TableColumn fx:id="contactInfoColumn" prefWidth="300.0" text="Контактные данные" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </children>
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
        </VBox>
    </items>
</SplitPane>