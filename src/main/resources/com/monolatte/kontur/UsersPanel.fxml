<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.25, 0.5" prefHeight="800.0" prefWidth="1280.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.monolatte.kontur.controllers.UsersPanelController">
    <items>
        <VBox spacing="10.0" styleClass="side-panel">
            <children>
                <Label styleClass="section-header" text="ПОЛЬЗОВАТЕЛИ" />
                <ListView fx:id="usersListView" onMouseClicked="#onUsersListViewMouseClicked" VBox.vgrow="ALWAYS" />
                <HBox spacing="5.0">
                    <children>
                        <Button fx:id="addEmptyButton" maxWidth="1.7976931348623157E308" onAction="#onAddEmptyButtonClicked" text="+" HBox.hgrow="ALWAYS" />
                        <Button fx:id="removeButton" maxWidth="1.7976931348623157E308" onAction="#onRemoveButtonClicked" styleClass="button-danger" text="Удалить" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
        </VBox>

        <VBox spacing="10.0" styleClass="side-panel">
            <children>
                <Label styleClass="section-header" text="ПРИВЯЗАННЫЕ ПРОЕКТЫ" />
                <ListView fx:id="projectsListView" onMouseClicked="#onProjectsListViewMouseClicked" VBox.vgrow="ALWAYS" />
                <HBox spacing="5.0">
                    <children>
                        <Button fx:id="pinButton" maxWidth="1.7976931348623157E308" onAction="#onPinButtonClicked" text="Привязать" HBox.hgrow="ALWAYS" />
                        <Button fx:id="unpinButton" maxWidth="1.7976931348623157E308" onAction="#onUnpinButtonClicked" text="Отвязать" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
        </VBox>

        <VBox spacing="15.0" styleClass="content-panel">
            <children>
                <VBox spacing="10.0" styleClass="details-card" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-header" text="ПЕРСОНАЛЬНЫЕ ДАННЫЕ" />
                        <GridPane hgap="15.0" vgap="10.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="ALWAYS" />
                            </rowConstraints>
                            <children>
                                <Label text="ID Пользователя" />
                                <TextField fx:id="idUserTextField" editable="false" styleClass="read-only-field" GridPane.columnIndex="1" />

                                <Label text="Имя" GridPane.rowIndex="1" />
                                <TextField fx:id="nameUserTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Описание" GridPane.rowIndex="2" GridPane.valignment="TOP" />
                                <TextArea fx:id="descriptionUserTextField" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                        <Separator prefWidth="200.0" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="addUserButton" onAction="#onAddUserButtonClicked" text="Создать нового" />
                                <Button fx:id="saveDataButton" onAction="#onSaveDataButtonClicked" styleClass="button-primary" text="Сохранить изменения" />
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </children>
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
        </VBox>
    </items>
</SplitPane>