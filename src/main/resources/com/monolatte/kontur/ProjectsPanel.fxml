<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.monolatte.kontur.controllers.ProjectsPanelController">
    <children>
        <SplitPane dividerPositions="0.25" VBox.vgrow="ALWAYS" styleClass="main-split-pane">
            <items>
                <VBox spacing="10.0" styleClass="side-panel">
                    <children>
                        <Label text="ПРОЕКТЫ" styleClass="section-header"/>
                        <ListView fx:id="projectListView" onMouseClicked="#_onProjectListViewMouseClicked" VBox.vgrow="ALWAYS" />
                        <GridPane hgap="5.0" vgap="5.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" />
                                <ColumnConstraints hgrow="SOMETIMES" />
                            </columnConstraints>
                            <children>
                                <Button fx:id="addEmptyButton" maxWidth="1.7976931348623157E308" onAction="#addEmptyButtonClicked" text="Добавить" />
                                <Button fx:id="removeButton" maxWidth="1.7976931348623157E308" onAction="#removeButtonClicked" text="Удалить" styleClass="button-danger" GridPane.columnIndex="1" />
                                <Button fx:id="openInTableButton" maxWidth="1.7976931348623157E308" onAction="#onOpenInTableButton" text="Таблица" GridPane.rowIndex="1" />
                                <Button fx:id="openUserButton" maxWidth="1.7976931348623157E308" onAction="#onOpenUserButtonClicked" text="Пользователи" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </children>
                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                </VBox>

                <VBox spacing="15.0" styleClass="content-panel">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-bar">
                            <children>
                                <Label text="Поиск:" />
                                <TextField fx:id="searchTextField" HBox.hgrow="ALWAYS" promptText="Введите текст..." />
                                <ChoiceBox fx:id="columnSorterChoiceBox" prefWidth="150.0" />
                                <Button fx:id="searchButton" onAction="#onSearchButton" text="Найти" styleClass="button-primary" />
                                <Button fx:id="resetSearchButton" onAction="#onResetSearchButton" text="Сброс" />
                            </children>
                            <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0" /></padding>
                        </HBox>

                        <SplitPane dividerPositions="0.6" orientation="VERTICAL" VBox.vgrow="ALWAYS" styleClass="inner-split-pane">
                            <items>
                                <VBox spacing="10.0" styleClass="details-card">
                                    <children>
                                        <Label text="ДЕТАЛИ ПРОЕКТА" styleClass="section-header"/>
                                        <GridPane hgap="15.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" />
                                            </columnConstraints>
                                            <children>
                                                <Label text="ID Проекта" />
                                                <TextField fx:id="idTextField" editable="false" GridPane.columnIndex="1" styleClass="read-only-field" />

                                                <Label text="Название" GridPane.rowIndex="1" />
                                                <TextField fx:id="nameTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label text="Дата начала" GridPane.rowIndex="2" />
                                                <TextField fx:id="startDateTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label text="Дата конца" GridPane.rowIndex="3" />
                                                <TextField fx:id="endDateTextField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                <Label text="Статус" GridPane.rowIndex="4" />
                                                <ChoiceBox fx:id="statusChoiceBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                                <Label text="Компоненты" GridPane.rowIndex="5" />
                                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                                    <children>
                                                        <ListView fx:id="inprojectComponentsListView" prefHeight="120.0" />
                                                        <HBox spacing="5.0">
                                                            <children>
                                                                <Button onAction="#addInProjectComponentButtonClicked" text="+" />
                                                                <Button onAction="#onChangeInProjectComponentButton" text="✎" />
                                                                <Button onAction="#removeInProjectComponentButtonClicked" text="-" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <children>
                                                <Button fx:id="addProjectButton" onAction="#addProjectButtonClicked" text="Создать новый" />
                                                <Button fx:id="saveDataButton" onAction="#saveDataButtonClicked" text="Сохранить" styleClass="button-primary" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                </VBox>

                                <VBox spacing="10.0" styleClass="details-card">
                                    <children>
                                        <Label text="ПОЛЬЗОВАТЕЛИ ПРОЕКТА" styleClass="section-header"/>
                                        <ListView fx:id="userListView" VBox.vgrow="ALWAYS" />
                                    </children>
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                </VBox>
                            </items>
                        </SplitPane>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </items>
        </SplitPane>
    </children>
</VBox>