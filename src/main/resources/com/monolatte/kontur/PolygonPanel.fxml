<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane prefHeight="600.0" prefWidth="900.0" styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/17.0.12"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.monolatte.kontur.controllers.polygonPanelController">
    <tabs>
        <Tab text="Примеры запросов">
            <content>
                <VBox spacing="15.0" styleClass="content-panel">
                    <children>
                        <HBox spacing="20.0" styleClass="details-card">
                            <children>
                                <RadioButton fx:id="projectsRadioButton" text="Проекты" />
                                <RadioButton fx:id="usersRadioButton" text="Пользователи" />
                                <RadioButton fx:id="usersContactsRadioButton" text="Адреса пользователей" />
                            </children>
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        </HBox>
                        <AnchorPane fx:id="tableContainer1" styleClass="details-card" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </content>
        </Tab>

        <Tab text="Полная запись Select">
            <content>
                <VBox spacing="15.0" styleClass="content-panel">
                    <children>
                        <VBox spacing="10.0" styleClass="details-card">
                            <children>
                                <Label styleClass="section-header" text="ПАРАМЕТРЫ ФИЛЬТРАЦИИ" />
                                <GridPane hgap="15.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" />
                                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="ID проекта" />
                                        <TextField fx:id="idProjectTextField1" GridPane.columnIndex="1" />

                                        <CheckBox fx:id="projectsCostCheckBox" text="Стоимость проекта" GridPane.rowIndex="1" />
                                        <TextField fx:id="projectsCostTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <CheckBox fx:id="sortedByCostCheckBox" text="Сорт. по убыванию" GridPane.rowIndex="2" />

                                        <Label styleClass="section-header" text="ДЕТАЛИЗАЦИЯ" GridPane.columnIndex="2" />
                                        <VBox spacing="8.0" GridPane.columnIndex="3" GridPane.rowSpan="3">
                                            <children>
                                                <RadioButton fx:id="costRadioButton" text="Стоимость по статусу" />
                                                <RadioButton fx:id="showProjectsRadioButton" text="Вывод всех проектов" />
                                                <RadioButton fx:id="withoutDetailsRadioButton" text="Без детализации" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>
                                <Button fx:id="showResult1" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="Выполнить сложный запрос" />
                            </children>
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        </VBox>
                        <AnchorPane fx:id="tableContainer2" styleClass="details-card" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </content>
        </Tab>

        <Tab text="Пример подзапросов">
            <content>
                <VBox spacing="15.0" styleClass="content-panel">
                    <children>
                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="10.0" styleClass="details-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-header" text="УСЛОВИЕ" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="ID проекта:" />
                                                <TextField fx:id="idProjectTextField2" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <Separator />
                                        <RadioButton fx:id="correlatedQueryRadioButton" text="Коррелированный запрос" />
                                        <RadioButton fx:id="uncorrelatedQueryRadioButton" text="Некоррелированный запрос" />
                                        <Button fx:id="showResultButton2" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="Запустить подзапрос" />
                                    </children>
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                </VBox>
                            </children>
                        </HBox>
                        <AnchorPane fx:id="tableContainer3" styleClass="details-card" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </content>
        </Tab>

        <Tab text="Изменение данных">
            <content>
                <VBox spacing="15.0" styleClass="content-panel">
                    <children>
                        <HBox spacing="15.0" VBox.vgrow="SOMETIMES">
                            <children>
                                <VBox spacing="10.0" styleClass="details-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="15.0">
                                            <children>
                                                <RadioButton fx:id="addProjectsDataRadioButton" text="Добавить" />
                                                <RadioButton fx:id="changeProjectsDataRadioButton" text="Изменить" />
                                                <RadioButton fx:id="deleteProjectsDataRadioButton" text="Удалить" />
                                            </children>
                                        </HBox>
                                        <GridPane hgap="10.0" vgap="8.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" />
                                            </columnConstraints>
                                            <children>
                                                <Label text="ID" />
                                                <TextField fx:id="idProjectTextField3" GridPane.columnIndex="1" />
                                                <Label text="Название" GridPane.rowIndex="1" />
                                                <TextField fx:id="nameProjectTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label text="Начало" GridPane.rowIndex="2" />
                                                <TextField fx:id="startDateProjectTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <Label text="Конец" GridPane.rowIndex="3" />
                                                <TextField fx:id="endDateProjectTextField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                <Label text="Статус" GridPane.rowIndex="4" />
                                                <TextField fx:id="statusProjectTextField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                <CheckBox fx:id="completeProjectCheckBox" text="Завершен" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                            </children>
                                        </GridPane>
                                        <Button fx:id="requestButton" maxWidth="1.7976931348623157E308" styleClass="button-primary" text="ВЫПОЛНИТЬ ОПЕРАЦИЮ" />
                                    </children>
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                </VBox>
                                <VBox spacing="10.0" styleClass="details-card" prefWidth="250.0">
                                    <children>
                                        <Label styleClass="section-header" text="КОМПОНЕНТЫ" />
                                        <ListView fx:id="projectsComponentsListVuew" VBox.vgrow="ALWAYS" />
                                        <Button fx:id="showResultButton3" maxWidth="1.7976931348623157E308" text="Обновить список" />
                                    </children>
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                </VBox>
                            </children>
                        </HBox>
                        <AnchorPane fx:id="tableContainer4" styleClass="details-card" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </content>
        </Tab>
    </tabs>
</TabPane>